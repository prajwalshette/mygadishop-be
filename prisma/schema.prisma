// MyGaadiShop - Complete Database Schema
// Prisma Schema for Second Hand Vehicle Management Platform

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// ============= PLATFORM ADMIN (Your Team) ===========
model Admin {
  id          String            @id
  name        String
  email       String            @unique
  phone       String?           @unique
  role        PlatformAdminRole
  password    String
  permissions String[]
  is_active   Boolean           @default(true)
  deleted_at  DateTime?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id          String   @id
  admin_id    String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model User {
  id         String       @id
  shop_id    String
  name       String?
  email      String       @unique
  phone      String?      @unique
  role       ShopUserRole @default(STAFF)
  password   String
  is_active  Boolean      @default(true)
  deleted_at DateTime?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  shop      Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  sessions  UserSession[]
  inquiries Inquiry[]

  @@unique([shop_id, email])
  @@index([shop_id, role])
}

model UserSession {
  id          String   @id
  user_id     String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ============= SHOP OWNER & SHOP ===========
model Shop {
  id         String  @id
  shop_name  String
  owner_name String
  email      String  @unique
  phone      String  @unique
  address    String
  city       String
  state      String
  pincode    String
  gstin      String? @unique

  // Shop Details
  website_url      String?
  shop_logo_url    String?
  shop_type        ShopType @default(TWO_WHEELER)
  established_year Int?

  description    String?
  business_hours Json? // {monday: {open: "09:00", close: "18:00"}}

  // NEW: Social Media
  facebook_url    String?
  instagram_url   String?
  twitter_url     String?
  youtube_url     String?
  whatsapp_number String?

  // Subscription & Status
  subscription_status SubscriptionStatus    @default(TRIAL)
  subscription_plan   SubscriptionPlanName?
  plan_start_date     DateTime?
  plan_end_date       DateTime?
  trial_ends_at       DateTime?
  is_verified         Boolean               @default(false)
  is_active           Boolean               @default(true)
  deleted_at          DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users           User[]
  customers       Customer[]
  vehicles        Vehicle[]
  services        Servicing[]
  payments        VehiclePayment[]
  subscriptions   ShopSubscription[]
  transactions    Transaction[]
  inquiries       Inquiry[]
  vehicleExpenses VehicleExpense[]
}

// ============= SUBSCRIPTION PLANS ===========
model SubscriptionPlan {
  id              String  @id
  plan_name       String  @unique // BASIC, PREMIUM, ENTERPRISE
  description     String?
  is_active       Boolean @default(true)
  // Features & Limits
  max_vehicles    Int? // null = unlimited
  max_staff_users Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  pricing       SubscriptionPricing[]
  subscriptions ShopSubscription[]
}

model SubscriptionPricing {
  id         String       @id
  plan_id    String
  duration   PlanDuration
  price      Float // in INR
  discount   Float        @default(0) // percentage
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  plan SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  shop_subscriptions ShopSubscription[]

  @@unique([plan_id, duration])
  @@index([plan_id])
}

// ============= SHOP SUBSCRIPTION ===========
model ShopSubscription {
  id                      String @id
  shop_id                 String
  plan_id                 String
  subscription_pricing_id String

  // Subscription Details
  start_date DateTime
  end_date   DateTime
  status     SubscriptionStatus @default(ACTIVE)
  auto_renew Boolean            @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop         Shop                @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [plan_id], references: [id])
  pricing      SubscriptionPricing @relation(fields: [subscription_pricing_id], references: [id])
  transactions Transaction[]

  @@index([shop_id, status])
}

// ============= TRANSACTIONS (Razorpay Payments) ===========
model Transaction {
  id              String  @id
  shop_id         String
  subscription_id String?

  // Transaction Details
  amount         Float // in INR
  currency       String            @default("INR")
  status         TransactionStatus @default(PENDING)
  payment_method String? // card, upi, netbanking, wallet

  // Razorpay IDs
  razorpay_order_id   String? @unique
  razorpay_payment_id String? @unique
  razorpay_signature  String?

  // Receipt & Invoice
  receipt_number String? @unique
  invoice_url    String?

  // Metadata
  description    String?
  notes          Json?
  failure_reason String?

  // Timestamps
  payment_date DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  shop         Shop              @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  subscription ShopSubscription? @relation(fields: [subscription_id], references: [id])

  @@index([shop_id, status])
  @@index([razorpay_order_id])
}

// ============= CUSTOMERS ===========
model Customer {
  id        String  @id
  shop_id   String
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  alt_phone String?
  gender    Gender?

  customer_type CustomerType @default(BUYER)
  deleted_at    DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  shop            Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicles_sold   Vehicle[]        @relation("VehicleSeller")
  vehicles_bought Vehicle[]        @relation("VehicleBuyer")
  services        Servicing[]
  payments        VehiclePayment[]
  inquiries       Inquiry[]

  @@unique([shop_id, phone])
  @@index([shop_id, customer_type])
}

// ============= VEHICLES ===========
model Vehicle {
  id                 String  @id
  shop_id            String
  seller_customer_id String? // WHO sold this vehicle TO the shop (filled at purchase)
  buyer_customer_id  String? // WHO bought this vehicle FROM the shop (filled at sale)

  // ── Identity ─────────────────────────────────────
  vehicle_category  VehicleCategory // TWO_WHEELER | FOUR_WHEELER | THREE_WHEELER | COMMERCIAL
  vehicle_type      VehicleType // BIKE | SCOOTER | CAR | AUTO_RICKSHAW | TRUCK etc.
  brand             String
  model             String
  variant           String?
  manufacture_year  Int // Year of manufacture
  registration_year Int? // Year first registered (may differ)
  color             String

  // ── Registration & Compliance ─────────────────────
  registration_number     String
  chassis_number          String
  engine_number           String
  registration_valid_till DateTime?
  insurance_valid_till    DateTime?
  insurance_type          InsuranceType? // COMPREHENSIVE | THIRD_PARTY | EXPIRED
  puc_valid_till          DateTime?
  is_hypothecation        Boolean        @default(false) // Bank loan/lien
  hypothecation_bank      String? // Bank name if under loan
  rc_available            Boolean        @default(true)

  // ── Ownership ─────────────────────────────────────
  ownership       OwnershipType @default(FIRST)
  ownership_city  String? // City where vehicle was previously registered
  ownership_state String? // State — important for re-registration

  // ── Odometer & Condition ──────────────────────────
  odometer_reading Int // in km — at time of buying
  condition        VehicleCondition // EXCELLENT | GOOD | FAIR | POOR
  accident_history Boolean          @default(false)
  flood_affected   Boolean          @default(false)
  condition_notes  String? // Free text: "minor dent on left door"

  // ── Fuel & Drivetrain (universal) ─────────────────
  fuel_type    FuelType
  transmission TransmissionType

  // ── Pricing ───────────────────────────────────────
  buying_price          Float?
  selling_price         Float?
  min_selling_price     Float? // Never exposed to public API
  is_price_negotiable   Boolean @default(true)
  estimated_rto_charges Float? // Re-registration cost estimate

  // ── Status & Dates ────────────────────────────────
  status       VehicleStatus
  buying_date  DateTime?
  selling_date DateTime?

  // ── Media ─────────────────────────────────────────
  vehicle_image_urls    String[] // Ordered — first image = cover
  vehicle_doc_urls      String[] // RC, Insurance, PUC scans
  inspection_report_url String? // Third-party inspection PDF

  // ── Public Listing ────────────────────────────────
  features         String[] // ["ABS", "Dual Airbags", "Sunroof"]
  description      String? // Freeform dealer notes
  is_featured      Boolean   @default(false)
  featured_until   DateTime?
  view_count       Int       @default(0)
  slug             String?   @unique
  meta_title       String?
  meta_description String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // ── Relations ─────────────────────────────────────
  shop            Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  seller_customer Customer? @relation("VehicleSeller", fields: [seller_customer_id], references: [id])
  buyer_customer  Customer? @relation("VehicleBuyer", fields: [buyer_customer_id], references: [id])

  two_wheeler_detail  TwoWheelerDetail?
  four_wheeler_detail FourWheelerDetail?

  payments         VehiclePayment[]
  inquiries        Inquiry[]
  vehicleDocuments VehicleDocument[]
  vehicleExpenses  VehicleExpense[]

  @@unique([shop_id, registration_number])
  @@unique([shop_id, chassis_number])
  @@index([shop_id, status])
  @@index([shop_id, vehicle_category])
  @@index([shop_id, vehicle_type])
  @@index([shop_id, seller_customer_id])
  @@index([shop_id, buyer_customer_id])
}

model TwoWheelerDetail {
  id         String @id
  vehicle_id String @unique

  // Specs
  engine_capacity_cc   Int? // e.g. 125, 150, 200
  max_power_bhp        Float? // e.g. 12.5 bhp
  max_torque_nm        Float? // e.g. 10.5 Nm
  top_speed_kmh        Int?
  mileage_kmpl         Float? // Fuel efficiency (petrol)
  range_km             Float? // Range for electric
  battery_capacity_kwh Float? // For EV only
  charging_time_hrs    Float? // For EV only

  // Type-specific
  two_wheeler_type TwoWheelerType // BIKE | SCOOTER | MOPED | ELECTRIC_SCOOTER | ELECTRIC_BIKE
  start_type       StartType? // KICK | SELF | BOTH
  abs_type         AbsType? // NO_ABS | SINGLE_CHANNEL | DUAL_CHANNEL
  has_disc_brake   Boolean        @default(false)
  has_alloy_wheels Boolean        @default(false)
  has_bluetooth    Boolean        @default(false) // Instrument cluster

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
}

model FourWheelerDetail {
  id         String @id
  vehicle_id String @unique

  // Specs
  body_type            CarBodyType // HATCHBACK | SEDAN | SUV | MUV | CROSSOVER | CONVERTIBLE | COUPE
  engine_capacity_cc   Int? // e.g. 998, 1497, 1996
  max_power_bhp        Float?
  max_torque_nm        Float?
  mileage_kmpl         Float?
  range_km             Float? // EV range
  battery_capacity_kwh Float? // EV battery
  no_of_cylinders      Int? // 3, 4, 6
  drive_type           DriveType? // FWD | RWD | AWD | 4WD
  no_of_doors          Int? // 3, 4, 5
  seating_capacity     Int?
  boot_space_litres    Int?

  // Safety & Features
  no_of_airbags Int?
  has_abs       Boolean @default(false)
  has_esp       Boolean @default(false) // Electronic Stability Program
  ncap_rating   Int? // 0-5 stars

  // Comfort
  has_sunroof          Boolean @default(false)
  has_cruise_control   Boolean @default(false)
  has_android_auto     Boolean @default(false)
  has_apple_carplay    Boolean @default(false)
  has_360_camera       Boolean @default(false)
  has_ventilated_seats Boolean @default(false)

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
}

// ============================================================
// VEHICLE DOCUMENTS — NEW
// ============================================================

model VehicleDocument {
  id          String         @id
  vehicle_id  String
  doc_type    DocumentType
  status      DocumentStatus @default(AVAILABLE)
  file_url    String?
  expiry_date DateTime?
  notes       String?
  uploaded_at DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@unique([vehicle_id, doc_type])
  @@map("vehicle_documents")
}

model VehicleExpense {
  id           String      @id
  shop_id      String
  vehicle_id   String
  expense_type ExpenseType
  description  String?
  amount       Float
  vendor_name  String? // who did the work
  receipt_url  String? // photo of bill
  expense_date DateTime    @default(now())
  created_by   String? // staff user ID

  deleted_at DateTime?
  created_at DateTime  @default(now())

  shop    Shop    @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)

  @@index([vehicle_id])
  @@index([shop_id, expense_date])
}

// ============= SERVICING ===========
model Servicing {
  id          String @id
  shop_id     String
  customer_id String

  vehicle_brand      String
  vehicle_model      String
  vehicle_variant    String?
  vehicle_year       Int?
  vehicle_type       VehicleType
  vehicle_reg_number String?

  service_date   DateTime
  service_type   String
  description    String?
  parts_replaced String[]
  labor_cost     Float    @default(0)
  parts_cost     Float    @default(0)
  other_charges  Float    @default(0) // NEW: Washing, inspection, etc.
  total_cost     Float

  status            ServicingStatus
  next_service_date DateTime?
  next_service_km   Int? // Next service at X km
  technician_name   String?

  // Current odometer reading
  odometer_reading Int?

  // Quality rating (customer feedback)
  rating            Int? // 1-5 stars
  customer_feedback String?

  // ── Payment ──────────────────────────────────────────
  payment_status PaymentStatus  @default(PENDING)
  paid_amount    Float          @default(0)
  payment_method PaymentMethod?
  payment_date   DateTime?

  service_images String[]
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, customer_id])
}

// ============= PAYMENTS ===========
model VehiclePayment {
  id          String @id
  shop_id     String
  vehicle_id  String
  customer_id String

  amount       Float
  paid_amount  Float?
  balance_due  Float?
  payment_type PaymentType   @default(VEHICLE_SALE)
  method       PaymentMethod
  status       PaymentStatus

  // NEW: Payment date
  payment_date DateTime @default(now())

  // NEW: Cheque details
  cheque_number String?
  cheque_date   DateTime?
  bank_name     String?
  cheque_status ChequeStatus?

  transaction_id         String?
  payment_receipt_images String[]
  notes                  String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, vehicle_id])
  @@index([shop_id, customer_id])
  @@index([shop_id, payment_date])
}

// ============= INQUIRIES / LEADS ===========
model Inquiry {
  id          String  @id
  shop_id     String
  customer_id String?
  vehicle_id  String? // If inquiry about specific vehicle
  assigned_to String? // User ID

  // Inquiry Details
  inquiry_type InquiryType
  status       InquiryStatus   @default(NEW)
  priority     InquiryPriority @default(MEDIUM)

  // Customer Info (if not registered)
  customer_name  String
  customer_phone String
  customer_email String?

  // Inquiry Content
  vehicle_type     VehicleType?
  budget_min       Float?
  budget_max       Float?
  preferred_brands String[]
  message          String?
  requirements     Json? // Detailed requirements

  // Source Tracking
  source      InquirySource @default(WALK_IN)
  referred_by String?

  // Follow-up
  follow_up_date  DateTime?
  follow_up_notes String

  // Conversion
  converted_at     DateTime?
  conversion_value Float?

  // Lost/Closed
  closed_at      DateTime?
  closure_reason String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  shop     Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customer_id], references: [id])
  vehicle  Vehicle?      @relation(fields: [vehicle_id], references: [id])
  user     User?         @relation(fields: [assigned_to], references: [id])
  notes    InquiryNote[]

  @@index([shop_id, status])
  @@index([shop_id, inquiry_type])
  @@index([shop_id, assigned_to])
  @@index([created_at])
}

// Inquiry Notes/Comments
model InquiryNote {
  id          String   @id
  inquiry_id  String
  user_id     String?
  note        String
  is_internal Boolean  @default(false) // Internal note (not shown to customer)
  created_at  DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)

  @@index([inquiry_id, created_at])
}

model NotificationLog {
  id         String              @id
  user_id    String
  user_type  UserType
  title      String
  body       String
  data       Json? // deep link payload
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  sent_at    DateTime?
  read_at    DateTime?
  created_at DateTime            @default(now())

  @@index([user_id, user_type])
  @@index([status])
}

model DeviceToken {
  id           String   @id
  token        String   @unique // FCM token (Android) or APNS token (iOS)
  platform     Platform // ANDROID | IOS | WEB
  user_type    UserType // SHOP_USER | PUBLIC_USER
  user_id      String // ID from User or PublicUser table
  device_info  Json? // model, OS version, app version
  is_active    Boolean  @default(true)
  last_used_at DateTime @default(now())
  created_at   DateTime @default(now())

  @@index([user_id, user_type])
  @@index([is_active])
}

// ============= ENUMS ===========
enum PlatformAdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShopUserRole {
  OWNER
  MANAGER
  STAFF
}

enum ShopType {
  TWO_WHEELER
  FOUR_WHEELER
  THREE_WHEELER
  COMMERCIAL
}

