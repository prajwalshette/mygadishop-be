// MyGaadiShop - Complete Database Schema
// Prisma Schema for Second Hand Vehicle Management Platform

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============= PLATFORM ADMIN (Your Team) ===========
model Admin {
  id          String            @id
  name        String
  email       String            @unique
  phone       String?           @unique
  role        PlatformAdminRole
  password    String
  permissions String[]
  is_active   Boolean           @default(true)
  deleted_at  DateTime?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id          String   @id
  admin_id    String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model User {
  id         String       @id
  shop_id    String
  name       String?
  email      String       @unique
  phone      String?      @unique
  role       ShopUserRole @default(STAFF)
  password   String
  is_active  Boolean      @default(true)
  deleted_at DateTime?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  shop      Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  sessions  UserSession[]
  inquiries Inquiry[]

  @@unique([shop_id, email])
  @@index([shop_id, role])
}

model UserSession {
  id          String   @id
  user_id     String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ============= SHOP OWNER & SHOP ===========
model Shop {
  id         String  @id
  shop_name  String
  owner_name String
  email      String  @unique
  phone      String  @unique
  address    String
  city       String
  state      String
  pincode    String
  gstin      String? @unique

  // Shop Details
  website_url      String?
  shop_logo_url    String?
  shop_type        ShopType @default(BOTH)
  established_year Int?

  description    String?
  business_hours Json? // {monday: {open: "09:00", close: "18:00"}}

  // NEW: Social Media
  facebook_url    String?
  instagram_url   String?
  twitter_url     String?
  youtube_url     String?
  whatsapp_number String?

  // Subscription & Status
  subscription_status SubscriptionStatus    @default(TRIAL)
  subscription_plan   SubscriptionPlanName?
  plan_start_date     DateTime?
  plan_end_date       DateTime?
  trial_ends_at       DateTime?
  is_verified         Boolean               @default(false)
  is_active           Boolean               @default(true)
  deleted_at          DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users         User[]
  customers     Customer[]
  vehicles      Vehicle[]
  services      Servicing[]
  payments      VehiclePayment[]
  subscriptions ShopSubscription[]
  transactions  Transaction[]
  inquiries     Inquiry[]
}

// ============= SUBSCRIPTION PLANS ===========
model SubscriptionPlan {
  id              String  @id
  plan_name       String  @unique // BASIC, PREMIUM, ENTERPRISE
  description     String?
  is_active       Boolean @default(true)
  // Features & Limits
  max_vehicles    Int? // null = unlimited
  max_staff_users Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  pricing       SubscriptionPricing[]
  subscriptions ShopSubscription[]
}

model SubscriptionPricing {
  id         String       @id
  plan_id    String
  duration   PlanDuration
  price      Float // in INR
  discount   Float        @default(0) // percentage
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  plan SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  shop_subscriptions ShopSubscription[]

  @@unique([plan_id, duration])
  @@index([plan_id])
}

// ============= SHOP SUBSCRIPTION ===========
model ShopSubscription {
  id                      String @id
  shop_id                 String
  plan_id                 String
  subscription_pricing_id String

  // Subscription Details
  start_date DateTime
  end_date   DateTime
  status     SubscriptionStatus @default(ACTIVE)
  auto_renew Boolean            @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop         Shop                @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan    @relation(fields: [plan_id], references: [id])
  pricing      SubscriptionPricing @relation(fields: [subscription_pricing_id], references: [id])
  transactions Transaction[]

  @@index([shop_id, status])
}

// ============= TRANSACTIONS (Razorpay Payments) ===========
model Transaction {
  id              String  @id
  shop_id         String
  subscription_id String?

  // Transaction Details
  amount         Float // in INR
  currency       String            @default("INR")
  status         TransactionStatus @default(PENDING)
  payment_method String? // card, upi, netbanking, wallet

  // Razorpay IDs
  razorpay_order_id   String? @unique
  razorpay_payment_id String? @unique
  razorpay_signature  String?

  // Receipt & Invoice
  receipt_number String? @unique
  invoice_url    String?

  // Metadata
  description    String?
  notes          Json?
  failure_reason String?

  // Timestamps
  payment_date DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  shop         Shop              @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  subscription ShopSubscription? @relation(fields: [subscription_id], references: [id])

  @@index([shop_id, status])
  @@index([razorpay_order_id])
}

// ============= CUSTOMERS ===========
model Customer {
  id        String  @id
  shop_id   String
  name      String
  phone     String
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  alt_phone String?
  gender    Gender?

  customer_type CustomerType @default(BUYER)
  deleted_at    DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  shop      Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]
  services  Servicing[]
  payments  VehiclePayment[]
  inquiries Inquiry[]

  @@unique([shop_id, phone])
  @@index([shop_id, customer_type])
}

// ============= VEHICLES ===========
model Vehicle {
  id          String  @id
  shop_id     String
  customer_id String?

  // Vehicle Basic Info
  type                VehicleType
  brand               String
  model               String
  variant             String?
  year                Int
  registration_number String
  chassis_number      String
  engine_number       String
  color               String
  mileage             Float

  // Technical Details
  fuel_type               FuelType
  transmission            TransmissionType
  engine_capacity         Int? // in CC
  ownership               OwnershipType    @default(FIRST)
  insurance_valid_till    DateTime?
  registration_valid_till DateTime?
  puc_valid_till          DateTime?

  // Pricing
  buying_price        Float?
  selling_price       Float?
  min_selling_price   Float?
  is_price_negotiable Boolean @default(true)

  // Media
  vehicle_image_urls String[]
  vehicle_doc_urls   String[]

  // Status & Dates
  status       VehicleStatus
  buying_date  DateTime?
  selling_date DateTime?

  // Features & Description
  features    String[]
  description String?

  // NEW: Featured & Display
  is_featured    Boolean   @default(false)
  featured_until DateTime?
  view_count     Int       @default(0)

  // NEW: SEO for public website
  slug             String? @unique // URL-friendly identifier
  meta_title       String?
  meta_description String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  shop      Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer  Customer?        @relation(fields: [customer_id], references: [id])
  services  Servicing[]
  payments  VehiclePayment[]
  inquiries Inquiry[]

  @@unique([shop_id, registration_number])
  @@unique([shop_id, chassis_number])
  @@index([shop_id, status])
  @@index([shop_id, customer_id])
}

// ============= SERVICING ===========
model Servicing {
  id          String @id
  shop_id     String
  vehicle_id  String
  customer_id String

  service_date   DateTime
  service_type   String
  description    String?
  parts_replaced String[]
  labor_cost     Float    @default(0)
  parts_cost     Float    @default(0)
  other_charges  Float    @default(0) // NEW: Washing, inspection, etc.
  total_cost     Float

  status            ServicingStatus
  next_service_date DateTime?
  next_service_km   Int? // Next service at X km
  technician_name   String?

  // Current odometer reading
  odometer_reading Int?

  // Quality rating (customer feedback)
  rating            Int? // 1-5 stars
  customer_feedback String?

  service_images String[]
  deleted_at     DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, vehicle_id])
  @@index([shop_id, customer_id])
}

// ============= PAYMENTS ===========
model VehiclePayment {
  id          String @id
  shop_id     String
  vehicle_id  String
  customer_id String

  amount       Float
  payment_type PaymentType   @default(VEHICLE_SALE)
  method       PaymentMethod
  status       PaymentStatus

  // NEW: Payment date
  payment_date DateTime @default(now())

  // NEW: Cheque details
  cheque_number String?
  cheque_date   DateTime?
  bank_name     String?
  cheque_status ChequeStatus?

  transaction_id         String?
  payment_receipt_images String[]
  notes                  String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, vehicle_id])
  @@index([shop_id, customer_id])
  @@index([shop_id, payment_date])
}

// ============= INQUIRIES / LEADS ===========
model Inquiry {
  id          String  @id
  shop_id     String
  customer_id String?
  vehicle_id  String? // If inquiry about specific vehicle
  assigned_to String? // User ID

  // Inquiry Details
  inquiry_type InquiryType
  status       InquiryStatus   @default(NEW)
  priority     InquiryPriority @default(MEDIUM)

  // Customer Info (if not registered)
  customer_name  String
  customer_phone String
  customer_email String?

  // Inquiry Content
  vehicle_type     VehicleType?
  budget_min       Float?
  budget_max       Float?
  preferred_brands String[]
  message          String?
  requirements     Json? // Detailed requirements

  // Source Tracking
  source      InquirySource @default(WALK_IN)
  referred_by String?

  // Follow-up
  follow_up_date  DateTime?
  follow_up_notes String

  // Conversion
  converted_at     DateTime?
  conversion_value Float?

  // Lost/Closed
  closed_at      DateTime?
  closure_reason String?

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  shop     Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customer_id], references: [id])
  vehicle  Vehicle?      @relation(fields: [vehicle_id], references: [id])
  user     User?         @relation(fields: [assigned_to], references: [id])
  notes    InquiryNote[]

  @@index([shop_id, status])
  @@index([shop_id, inquiry_type])
  @@index([shop_id, assigned_to])
  @@index([created_at])
}

// Inquiry Notes/Comments
model InquiryNote {
  id          String   @id
  inquiry_id  String
  user_id     String?
  note        String
  is_internal Boolean  @default(false) // Internal note (not shown to customer)
  created_at  DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiry_id], references: [id], onDelete: Cascade)

  @@index([inquiry_id, created_at])
}

// ============= ENUMS ===========
enum PlatformAdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ShopUserRole {
  OWNER
  MANAGER
  STAFF
}

enum ShopType {
  TWO_WHEELER
  FOUR_WHEELER
  BOTH
}

enum ChequeStatus {
  PENDING
  CLEARED
  BOUNCED
}

enum SubscriptionPlanName {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum CustomerType {
  BUYER
  SELLER
  BOTH
}

enum VehicleType {
  BIKE
  SCOOTER
  CAR
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum OwnershipType {
  FIRST
  SECOND
  THIRD
  FOURTH_PLUS
}

enum VehicleStatus {
  AVAILABLE
  SOLD
  MAINTENANCE
  BOOKED
  ON_HOLD
}

enum ServicingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  CHEQUE
  EMI
}

enum PaymentType {
  VEHICLE_SALE
  VEHICLE_PURCHASE
  SERVICE
  ADVANCE
  REFUND
}

enum PlanDuration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
  PAYMENT_PENDING
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

//Inquiry Enums
enum InquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  LOST
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquiryType {
  BUYING
  SELLING
  SERVICE
  GENERAL
}

enum InquirySource {
  WALK_IN
  PHONE_CALL
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  REFERRAL
  OLX
  OTHER
}
