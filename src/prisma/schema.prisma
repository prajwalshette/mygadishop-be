// MyGaadiShop - Complete Database Schema
// Prisma Schema for Second Hand Vehicle Management Platform

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============= PLATFORM ADMIN (Your Team) ===========
model Admin {
  id          String            @id
  name        String
  email       String            @unique
  phone       String?           @unique
  role        PlatformAdminRole
  password    String
  permissions String[]
  is_active   Boolean           @default(true)
  is_deleted  Boolean           @default(false)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id          String   @id
  admin_id    String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model User {
  id         String       @id
  shop_id    String
  name       String?
  email      String       @unique
  phone      String?      @unique
  role       ShopUserRole @default(STAFF)
  password   String
  is_active  Boolean      @default(true)
  is_deleted Boolean      @default(false)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  shop     Shop          @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  sessions UserSession[]

  @@unique([shop_id, email])
  @@index([shop_id, role])
}

model UserSession {
  id          String   @id
  user_id     String
  token       String   @unique
  device_info Json?
  ip_address  String?
  created_at  DateTime @default(now())
  expires_at  DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ============= SHOP OWNER & SHOP ===========
model Shop {
  id         String  @id
  shop_name  String
  owner_name String
  email      String  @unique
  phone      String  @unique
  address    String
  city       String
  state      String
  pincode    String
  gstin      String? @unique

  // Shop Details
  website_url      String?
  shop_logo_url    String?
  shop_type        ShopType @default(BOTH)
  established_year Int?

  // Subscription & Status
  subscription_status SubscriptionStatus    @default(TRIAL)
  subscription_plan   SubscriptionPlanName?
  plan_start_date     DateTime?
  plan_end_date       DateTime?
  is_verified         Boolean               @default(false)
  is_active           Boolean               @default(true)
  is_deleted          Boolean               @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  users         User[]
  customers     Customer[]
  vehicles      Vehicle[]
  services      Servicing[]
  payments      VehiclePayment[]
  subscriptions ShopSubscription[]
  transactions  Transaction[]
}

// ============= SUBSCRIPTION PLANS ===========
model SubscriptionPlan {
  id              String  @id
  plan_name       String  @unique // BASIC, PREMIUM, ENTERPRISE
  description     String?
  is_active       Boolean @default(true)
  // Features & Limits
  max_vehicles    Int? // null = unlimited
  max_staff_users Int
  // has_sms_alerts   Boolean @default(false)
  // has_whatsapp     Boolean @default(false)
  // has_analytics    Boolean @default(false)
  // has_multi_branch Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  pricing       SubscriptionPricing[]
  subscriptions ShopSubscription[]
}

model SubscriptionPricing {
  id         String       @id
  plan_id    String
  duration   PlanDuration
  price      Float // in INR
  discount   Float        @default(0) // percentage
  is_active  Boolean      @default(true)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  plan SubscriptionPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, duration])
  @@index([plan_id]) 
}

// ============= SHOP SUBSCRIPTION ===========
model ShopSubscription {
  id                      String @id
  shop_id                 String
  plan_id                 String
  subscription_pricing_id String

  // Subscription Details
  start_date DateTime
  end_date   DateTime
  status     SubscriptionStatus @default(ACTIVE)
  auto_renew Boolean            @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop         Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [plan_id], references: [id])
  transactions Transaction[]

  @@index([shop_id, status])
}

// ============= TRANSACTIONS (Razorpay Payments) ===========
model Transaction {
  id              String  @id
  shop_id         String
  subscription_id String?

  // Transaction Details
  amount         Float // in INR
  currency       String            @default("INR")
  status         TransactionStatus @default(PENDING)
  payment_method String? // card, upi, netbanking, wallet

  // Razorpay IDs
  razorpay_order_id   String? @unique
  razorpay_payment_id String? @unique
  razorpay_signature  String?

  // Receipt & Invoice
  receipt_number String? @unique
  invoice_url    String?

  // Metadata
  description    String?
  notes          Json?
  failure_reason String?

  // Timestamps
  payment_date DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  shop         Shop              @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  subscription ShopSubscription? @relation(fields: [subscription_id], references: [id])

  @@index([shop_id, status])
  @@index([razorpay_order_id])
}

// ============= CUSTOMERS ===========
model Customer {
  id              String  @id
  shop_id         String
  name            String
  phone           String
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?

  customer_type CustomerType @default(BUYER)
  is_deleted    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  shop     Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  services Servicing[]
  payments VehiclePayment[]

  @@unique([shop_id, phone])
  @@index([shop_id, customer_type])
}

// ============= VEHICLES ===========
model Vehicle {
  id          String  @id
  shop_id     String
  customer_id String?

  // Vehicle Basic Info
  type                VehicleType
  brand               String
  model               String
  variant             String?
  year                Int
  registration_number String
  chassis_number      String
  engine_number       String
  color               String
  mileage             Float

  // Technical Details
  fuel_type            FuelType
  transmission         TransmissionType
  engine_capacity      Int? // in CC
  ownership            OwnershipType    @default(FIRST)
  insurance_valid_till DateTime?

  // Pricing
  buying_price   Float?
  selling_price  Float?

  // Media
  vehicle_image_urls String[]
  vehicle_doc_urls   String[]

  // Status & Dates
  status       VehicleStatus
  buying_date  DateTime?
  selling_date DateTime?

  // Features & Description
  features    String[]
  description String?

  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  shop     Shop             @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  customer Customer?        @relation(fields: [customer_id], references: [id])
  services Servicing[]
  payments VehiclePayment[]

  @@unique([shop_id, registration_number])
  @@unique([shop_id, chassis_number])

  @@index([shop_id, status])
  @@index([shop_id, customer_id])
}

// ============= SERVICING ===========
model Servicing {
  id          String @id
  shop_id     String
  vehicle_id  String
  customer_id String

  service_date   DateTime
  service_type   String
  description    String?
  parts_replaced String[]
  labor_cost     Float    @default(0)
  parts_cost     Float    @default(0)
  total_cost     Float

  status            ServicingStatus
  next_service_date DateTime?
  technician_name   String?

  service_images String[]
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, vehicle_id])
  @@index([shop_id, customer_id])
}

// ============= PAYMENTS ===========
model VehiclePayment {
  id          String @id
  shop_id     String
  vehicle_id  String
  customer_id String

  amount       Float
  payment_type PaymentType   @default(VEHICLE_SALE)
  method       PaymentMethod
  status       PaymentStatus

  transaction_id         String?
  payment_receipt_images String[]
  notes                  String?

  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop     Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([shop_id, status])
  @@index([shop_id, vehicle_id])
  @@index([shop_id, customer_id])
}

// ============= ENUMS ===========
enum PlatformAdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
}

enum ShopUserRole {
  OWNER
  MANAGER
  STAFF
}

enum ShopType {
  TWO_WHEELER
  FOUR_WHEELER
  BOTH
}

enum SubscriptionPlanName {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum CustomerType {
  BUYER
  SELLER
  BOTH
}

enum VehicleType {
  BIKE
  SCOOTER
  CAR
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum OwnershipType {
  FIRST
  SECOND
  THIRD
  FOURTH_PLUS
}

enum VehicleStatus {
  AVAILABLE
  SOLD
  MAINTENANCE
  BOOKED
  ON_HOLD
}

enum ServicingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
  CHEQUE
  EMI
}

enum PaymentType {
  VEHICLE_SALE
  VEHICLE_PURCHASE
  SERVICE
  ADVANCE
  REFUND
}

enum PlanDuration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
  PAYMENT_PENDING
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}
