{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "esnext.asynciterable"],
    "typeRoots": ["node_modules/@types"],
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "pretty": true,
    "sourceMap": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "allowJs": true,
    "noEmit": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@config": ["config"],
      "@modules/*": ["modules/*"],
      "@exceptions/*": ["exceptions/*"],
      "@interfaces/*": ["interfaces/*"],
      "@middlewares/*": ["middlewares/*"],
      "@utils/*": ["utils/*"],
      "@consumers/*": ["consumers/*"],
      "@prisma/client": ["../generated/prisma"],
      "@services/*": ["services/*"],
      "@validator/*": ["validator/*"],
      "@services/redis/*": ["services/redis/*"],
      "@services/redis/Queue/*": ["services/redis/Queue/*"],
      "@services/redis/cache/*": ["services/redis/cache/*"],
      "@services/redis/redisBullMQ": ["services/redis/redisBullMQ"],
      "@lib/*": ["lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "src/http", "src/logs"]
}
